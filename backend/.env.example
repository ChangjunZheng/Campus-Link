# 复制为 .env 后按需修改；本地开发默认值即可跑通
# 表结构不用手工导入：Flyway 在后端启动时自动执行 src/main/resources/db/migration/ 下未应用的迁移；
# 但库本身要先存在（建库属基础设施引导，不归 Flyway 管），见 AGENTS.md「常用命令」
# 注意：.env 不入 git（已在 .gitignore），生产环境密钥必须全部覆盖（上线检查清单项）

DB_HOST=localhost
DB_PORT=3306
DB_NAME=campuslink
DB_USER=campuslink
DB_PASSWORD=campuslink

REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 签名密钥：至少 32 字符；生产必须换随机长串
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# 敏感信息加密 / 学号哈希密钥：至少 32 字符；生产必须换（两把密钥独立管理）
APP_HASH_KEY=dev-only-hash-key-change-me-32-bytes-minimum!
APP_CRYPT_KEY=dev-only-crypt-key-change-me-32-bytes-minimum!

# 学籍核验旁路（内置测试名册学号须为 9 位数字，如 249971346/张三）：仅限开发联调；生产必须为 false
APP_ROSTER_BYPASS=true

# 验证码发送方式：log（开发，仅打日志）/ mail
CODE_SENDER_MODE=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# 固定验证码：默认 123456（开发便利，启动时打 WARN）。生产必须留空——
# 固定验证码等同于取消验证码防线（上线检查清单项）。此处刻意注释掉，
# 复制本文件为 .env 不会改变开发行为；部署前显式设为空值：
# CAPTCHA_FIXED_CODE=

# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173
