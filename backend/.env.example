# 复制为 .env 后按需修改；本地开发默认值即可跑通（sql 由 docker-compose 自动初始化）
# 注意：.env 不入 git（已在 .gitignore），生产环境密钥必须全部覆盖（上线检查清单项）

DB_HOST=localhost
DB_PORT=3306
DB_NAME=campuslink
DB_USER=campuslink
DB_PASSWORD=campuslink

REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 签名密钥：至少 32 字符；生产必须换随机长串
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# 敏感信息加密 / 学号哈希密钥：至少 32 字符；生产必须换（两把密钥独立管理）
APP_HASH_KEY=dev-only-hash-key-change-me-32-bytes-minimum!
APP_CRYPT_KEY=dev-only-crypt-key-change-me-32-bytes-minimum!

# 学籍核验旁路（内置测试名册 2023001/张三 等）：仅限开发联调；生产必须为 false
APP_ROSTER_BYPASS=true

# 验证码发送方式：log（开发，仅打日志）/ mail
CODE_SENDER_MODE=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173
