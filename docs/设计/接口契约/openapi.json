  "components": {
    "schemas": {
      "PublishPostCommand": {
        "type": "object",
        "properties": {
          "boardCode": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "contentMd": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 0
          }
        },
        "required": [
          "boardCode",
          "contentMd",
          "title"
        ]
      },
      "ApiResponsePublishedPost": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/PublishedPost"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "PublishedPost": {
        "type": "object",
        "properties": {
