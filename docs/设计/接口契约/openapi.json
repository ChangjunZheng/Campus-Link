              }
            }
          },
          "400": {
            "description": "参数错误（1001）；验证码错误或已过期（2001）；核验票据无效或已过期，请重新核验（2102）；学籍信息校验未通过（2101）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
