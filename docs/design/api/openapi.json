{
  "openapi": "3.1.0",
  "info": {
    "title": "Campus-Link API",
    "description": "重庆工程学院计算机专业学生交流论坛（MVP）。错误码分段见技术方案第 5 节。",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8088",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "admin-roster",
      "description": "学籍名册导入（仅 SUPERADMIN）"
    },
    {
      "name": "auth",
      "description": "学籍核验、注册与登录"
    },
    {
      "name": "user",
      "description": "用户"
    }
  ],
  "paths": {
    "/api/v1/auth/verify-student": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "学籍核验（F-ACC-004）：学号 + 姓名，通过返回一次性核验票据",
        "operationId": "verifyStudent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyStudentCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVerifyStudentResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "注册：需先通过学籍核验并携带票据",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "登录：邮箱 + 验证码",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/captcha": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "发送邮箱验证码（60s 重发间隔，单账号日上限 10 条）",
        "operationId": "captcha",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptchaCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/roster/import": {
      "post": {
        "tags": [
          "admin-roster"
        ],
        "summary": "CSV 导入：body 为 CSV 文本，格式“学号,姓名[,年级[,专业]]”",
        "operationId": "importRoster",
        "parameters": [
          {
            "name": "batch",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "manual"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseRosterImportResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "我的主页（F-ACC-002 最小版；他人主页与资料编辑在后续 Sprint）",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserVo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VerifyStudentCommand": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\d{9}"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:[\\p{IsHan}]{2,16}(?:[\\u00B7\\u30FB][\\p{IsHan}]{1,16})?|[A-Za-z][A-Za-z .'\\-]{1,63})$"
          }
        },
        "required": [
          "name",
          "studentId"
        ]
      },
      "ApiResponseVerifyStudentResult": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/VerifyStudentResult"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "VerifyStudentResult": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string"
          }
        }
      },
      "RegisterCommand": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\d{6}"
          },
          "nickname": {
            "type": "string",
            "maxLength": 32,
            "minLength": 2
          }
        },
        "required": [
          "code",
          "email",
          "nickname",
          "ticket"
        ]
      },
      "ApiResponseAuthResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AuthResponse"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAtEpochSecond": {
            "type": "integer",
            "format": "int64"
          },
          "user": {
            "$ref": "#/components/schemas/UserVo"
          }
        }
      },
      "UserVo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nickname": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "school": {
            "type": "string"
          },
          "major": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginCommand": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\d{6}"
          }
        },
        "required": [
          "code",
          "email"
        ]
      },
      "CaptchaCommand": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "target"
        ]
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {},
          "traceId": {
            "type": "string"
          }
        }
      },
      "ApiResponseRosterImportResult": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/RosterImportResult"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "RosterImportResult": {
        "type": "object",
        "properties": {
          "inserted": {
            "type": "integer",
            "format": "int32"
          },
          "skipped": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ApiResponseUserVo": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserVo"
          },
          "traceId": {
            "type": "string"
          }
        }
      }
    }
  }
}
